# Copy to .env or ~/.config/russhtviewer/masterdale.env

# Shared bearer with Masterdale / RustOpViewer.
DALE_TOKEN=replace-with-your-masterdale-token
# RUSSH_MASTERDALE_TOKEN=replace-with-your-masterdale-token

# Fleet registry host.
RUSSH_FLEET_HOST=http://<registry-tailscale-ip>:45090

# Optional listen port (default 45090).
# RUSSH_PORT=45090

# Optional device id override (default: hostname).
# RUSSH_DEVICE_ID=workstation
